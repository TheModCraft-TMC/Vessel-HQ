<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Vessel HQ — Setup timed out</title>
    <meta name="description" content="Vessel HQ setup session timed out" />
    <meta name="author" content="<%= author %>" />
    <meta name="robots" content="noindex" />
    <base id="base" />
    <link rel="icon" type="image/svg+xml" href="<%= require('./assets/ico/vessel-hq-mark.svg') %>" />
  </head>

  <body>
    <main class="page-wrapper">
      <section class="container simple-box" aria-labelledby="timeout-title">
        <div class="col-md-8 col-md-offset-2 col-sm-10 col-sm-offset-1">
          <div class="row">
            <img src="<%= require('./assets/images/vessel-hq-logo.svg') %>" class="simple-box-logo" alt="Vessel HQ" />
          </div>
          <div class="panel panel-default">
            <div class="panel-body">
              <h1 id="timeout-title" class="form-section-title">Vessel HQ setup timed out</h1>
              <p class="padding-top text-muted small">
                The initial setup session timed out for security. Restart Vessel HQ to begin setup again.
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
