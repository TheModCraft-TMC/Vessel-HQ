  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:frontend": "node scripts/start-frontend-dev.mjs",
    "start": "next start web-src --port 8999",
    "build": "bash scripts/package-next-standalone.sh --clean && next build web-src --webpack && bash scripts/package-next-standalone.sh",
    "analyze": "next experimental-analyze web-src --output",
    "format": "prettier --log-level warn --write  \"**/*.{js,css,html,jsx,tsx,ts}\"",
    "lint": "eslint --cache --fix \"./**/*.{js,jsx,ts,tsx}\"",
    "lint:ci": "./scripts/check-frontend-modernization.sh && node ./scripts/check-frontend-boundaries.mjs && node ./scripts/check-app-router-compliance.mjs && node ./scripts/check-css-module-classes.mjs && node --test ./scripts/check-css-module-classes.test.mjs && eslint --cache \"./**/*.{js,jsx,ts,tsx}\"",
    "test": "vitest run",
    "test:extensions": "vitest run --config vitest.extensions.config.mts",
    "sb": "pnpm run storybook",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build -o ./dist/storybook",
    "typecheck": "tsc --project web-src/tsconfig.json --noEmit",
    "check:frontend-modernization": "./scripts/check-frontend-modernization.sh",
    "check:frontend-boundaries": "node ./scripts/check-frontend-boundaries.mjs",
    "check:app-router-compliance": "node ./scripts/check-app-router-compliance.mjs",
    "check:css-module-classes": "node ./scripts/check-css-module-classes.mjs",
    "index:app-router-pages": "pnpm check:app-router-compliance && node ./scripts/index-app-router-pages.mjs",
    "generate-api": "openapi-ts",
    "postgenerate-api": "prettier --log-level warn --write web-src/core/generated-api/portainer",
    "swagger-cli": "node scripts/validate-openapi.mjs",
    "check:npm-security": "node scripts/check-npm-security.mjs",
    "test:dependency-security": "node --test scripts/check-npm-security.test.mjs scripts/check-dependency-styles.test.mjs scripts/check-markdown-security.test.mjs scripts/validate-openapi.test.mjs",
    "check:npm-security:fresh": "node scripts/audit-npm-fresh.mjs"
  },
